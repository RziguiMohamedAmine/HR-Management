{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "clientHR": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/client-hr",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/assets",
              "src/assets/img/favicon.png"
            ],
            "styles": [
              "src/assets/css/style.css",
              "src/assets/css/bootstrap.min.css",
              "src/assets/plugins/fontawesome/css/fontawesome.min.css",
              "src/assets/plugins/fontawesome/css/all.min.css",
              "src/assets/css/line-awesome.min.css",
              "src/assets/css/material.css",
              "src/assets/plugins/morris/morris.css",
              "src/assets/css/style.css",
              "src/assets/css/dataTables.bootstrap4.min.css",
              "src/assets/css/select2.min.css",
              "src/assets/css/ckeditor.css",
              "src/assets/css/feather.css",
              "src/assets/css/owl.carousel.min.css",
              "src/assets/css/material.css",
              "src/assets/css/bootstrap-datetimepicker.min.css",
              "src/assets/plugins/bootstrap-tagsinput/bootstrap-tagsinput.css",
              "src/assets/plugins/simpleline/simple-line-icons.css",
              "src/assets/plugins/select2/css/select2.min.css"
             
            ],
            "scripts": [
              "./node_modules/jquery/dist/jquery.min.js",
              "src/assets/js/app.js",
              "src/assets/js/bootstrap.bundle.min.js",
              "src/assets/js/chart.js",
              "src/assets/js/Chart.min.js",
              "src/assets/js/ckeditor.js",
              "src/assets/js/dataTables.bootstrap4.min.js",
              "src/assets/js/dropfiles.js",
              "src/assets/js/email-decode.min copy 2.js",
              "src/assets/js/email-decode.min copy.js",
              "src/assets/js/email-decode.min.js",
              "src/assets/js/feather.min.js",
              "src/assets/js/fullcalendar.min.js",
              "src/assets/js/greedynav.js",
              "src/assets/js/jquery-3.7.1.min.js",
              "src/assets/js/jquery-ui.min.js",
              "src/assets/js/jquery.dataTables.min.js",
              "src/assets/js/jquery.fullcalendar.js",
              "src/assets/js/jquery.maskedinput.min.js",
              "src/assets/js/jquery.slimscroll.min.js",
              "src/assets/js/jquery.ui.touch-punch.min.js",
              "src/assets/js/layout.js",
              "src/assets/js/line-chart.js",
              "src/assets/js/mask.js",
              "src/assets/js/modal.js",
              "src/assets/js/moment.min.js",
              "src/assets/js/multiselect.min.js",
              "src/assets/js/owl.carousel.min.js",
              "src/assets/js/rocket-loader.min.js",
              "src/assets/js/select2.min.js",
              "src/assets/js/task.js",
              "src/assets/js/theme-settings.js",
              "src/assets/plugins/morris/morris.min.js",
              "src/assets/plugins/morris/raphael-min.js",
              "src/assets/plugins/morris/chart-data.js",
              "src/assets/plugins/select2/js/custom-select.js",
              "src/assets/plugins/select2/js/select2.min.js",

              "src/assets/plugins/raty/custom.raty.js",
              "src/assets/plugins/raty/jquery.raty.js",
              "src/assets/plugins/scrollbar/custom-scroll.js",
              "src/assets/plugins/scrollbar/scrollbar.min.js",
              "src/assets/plugins/select2/js/select2.min.js",

              "src/assets/plugins/stickynote/sticky.js",
              "src/assets/plugins/summernote/summernote-bs4.min.js",
              "src/assets/plugins/sweetalert/sweetalert2.all.min.js",
              "src/assets/plugins/theia-sticky-sidebar/theia-sticky-sidebar.js",
              "src/assets/plugins/timeline/horizontal-timeline.js",
              "src/assets/plugins/toastr/toastr.js"

            ],
            "server": "src/main.server.ts",
            "prerender": true,
            "ssr": {
              "entry": "server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "clientHR:build:production"
            },
            "development": {
              "buildTarget": "clientHR:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "c38a9702-b444-4f62-a435-a7c2d6b8c2df"
  }
}
